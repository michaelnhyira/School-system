rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get user email from users collection
    function getUserEmail() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email
        : null;
    }
    
    // Helper function to get user role from userRoles collection (by email)
    function getUserRole() {
      // Special case: super admin email always has admin role
      return getUserEmail() == 'michaelnhyira77@gmail.com' 
        ? 'admin' 
        : (getUserEmail() != null && exists(/databases/$(database)/documents/userRoles/$(getUserEmail()))
          && get(/databases/$(database)/documents/userRoles/$(getUserEmail())).data.isActive == true 
          ? get(/databases/$(database)/documents/userRoles/$(getUserEmail())).data.role 
          : null);
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }
    
    // Helper function to check if user is teacher
    function isTeacher() {
      return isAuthenticated() && getUserRole() == 'teacher';
    }
    
    // Helper function to check if user is accountant
    function isAccountant() {
      return isAuthenticated() && getUserRole() == 'accountant';
    }
    
    // Helper function to check if user is admin or accountant
    function isAdminOrAccountant() {
      return isAdmin() || isAccountant();
    }
    
    // Users collection - only admins can read/write, users can read their own
    match /users/{userId} {
      allow read: if isAuthenticated() && (isAdmin() || request.auth.uid == userId);
      allow create: if isAdmin() || request.auth.uid == userId; // Allow users to create their own document on first login
      allow update: if isAdmin() || request.auth.uid == userId;
      allow delete: if isAdmin();
    }
    
    // UserRoles collection - authenticated users can read, admins can write
    match /userRoles/{email} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }
    
    // Students collection - all authenticated users can read, admins/teachers can write
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isTeacher();
      allow delete: if isAdmin();
    }
    
    // Teachers collection - all authenticated users can read, only admins can write
    match /teachers/{teacherId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }
    
    // Classes collection - all authenticated users can read, admins can write
    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
      
      // Subdivisions subcollection
      match /subdivisions/{subdivisionId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAdmin();
      }
    }
    
    // Subjects collection - all authenticated users can read, admins can write
    match /subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }
    
    // Academic periods collection - all authenticated users can read, admins/teachers can write
    match /academicPeriods/{periodId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || isTeacher();
    }
    
    // Grades academic periods collection - all authenticated users can read, admins/teachers can write
    match /gradesAcademicPeriods/{periodId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || isTeacher();
    }
    
    // Grades collection - all authenticated users can read, teachers/admins can write
    match /grades/{gradeId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || isTeacher();
    }
    
    // Attendance collection - all authenticated users can read, teachers/admins can write
    match /attendance/{periodId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || isTeacher();
      
      // Students subcollection
      match /students/{studentId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAdmin() || isTeacher();
      }
    }
    
    // Fees collection - all authenticated users can read, admins/accountants can write
    match /fees/{feeId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdminOrAccountant();
    }
    
    // Payments collection - all authenticated users can read, admins/accountants can write
    match /payments/{paymentId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdminOrAccountant();
    }
    
    // Completed batches collection - all authenticated users can read, admins can write
    match /completedBatches/{batchYear} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
      
      // Students subcollection
      match /students/{studentId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAdmin();
      }
    }
    
    // System collection - all authenticated users can read, only admins can write
    match /system/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // SMS points collection - all authenticated users can read, admins can write
    match /system/smsPoints {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Payment lock - all authenticated users can read, only super admin can write
    match /system/paymentLock {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && getUserEmail() == 'michaelnhyira77@gmail.com';
    }
    
    // User payment lock dismissal - all authenticated users can read/write their own dismissal
    match /users/{userId}/paymentLockDismissed/{document=**} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // Default: allow read for authenticated users, write based on admin role
    match /{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
